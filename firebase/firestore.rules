rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /allowlist/{email} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /vessels/{vesselId}/notes/{noteId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.id == noteId
        && request.resource.data.vesselId == vesselId;
      allow delete: if false;
    }

    /* Candados LOTO · un doc de estado por buque */
    match /vessels/{vesselId}/locks/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && docId == 'state'
        && request.resource.data.vesselId == vesselId
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    /* Energizaciones a bordo · un doc de estado por buque */
    match /vessels/{vesselId}/energizations/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && docId == 'state'
        && request.resource.data.vesselId == vesselId
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
  }
}
