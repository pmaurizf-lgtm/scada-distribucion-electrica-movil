# Copia a .env.local y rellena con el proyecto Firebase (punto común de notas).
# Sin estas variables la app funciona, pero cada móvil guarda solo en local.
#
# Correos autorizados: VITE_ALLOWED_EMAILS o Firestore allowlist/{email}.
# Administradores: VITE_ADMIN_EMAILS o allowlist/{email}.role = "admin".

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_ALLOWED_EMAILS=
VITE_ADMIN_EMAILS=
